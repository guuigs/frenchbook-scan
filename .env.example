# Clé API Mistral. Reste côté serveur : elle n'est jamais envoyée au navigateur.
MISTRAL_API_KEY=

# Code d'accès partagé de l'équipe, demandé au premier lancement sur chaque
# appareil puis mémorisé dans un cookie signé.
ACCESS_CODE=

# Secret de signature du cookie de session. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Modèle de lecture (facultatif, valeur par défaut ci-dessous).
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# Envoi du CSV d'import par mail (facultatif, mais les deux vont ensemble).
# MAIL_FROM doit être une adresse d'un domaine vérifié dans le compte Resend qui
# expédie : elle n'a pas de valeur par défaut, et rien n'est deviné à sa place.
# Le destinataire, lui, est écrit dans src/server/mail.ts.
# RESEND_API_KEY=
# MAIL_FROM=

# Référentiel des commandes clients (Supabase). Sans ces deux variables, le
# scan fonctionne mais l'écran de validation annonce que le référentiel n'est
# pas configuré. La clé est secrète et ne quitte jamais le serveur : ne posez
# jamais ici une clé publiable, elle ne pourrait rien lire.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=

# Met « Charger un bon de démonstration » dans les Réglages : un bon fictif de
# 7 titres pour parcourir tout le flux sans photo ni appel Mistral. À activer en
# local et sur les préversions, jamais en production.
# NEXT_PUBLIC_ENABLE_DEMO=1

# Signature du webhook de réception Resend (whsec_…), pour le dépôt d'une
# commande par courriel. Sans elle, la route /api/orders/inbound refuse tout.
RESEND_WEBHOOK_SECRET=
